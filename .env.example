# ==============================================================================
# SecureVault Enterprise Security Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and configure your secure values before launching:
#   cp .env.example .env
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5005
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production!
MASTER_ENCRYPTION_KEY=z7kM1xW4qP9_vR8tL2bY5eN0sH3uA6cI9gJ1fD4oX7k=

# Database Backend (Options: 'mysql' or 'sqlite')
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=securevault_db

# SQLite Fallback Path (Active when DB_TYPE=sqlite)
SQLITE_DB_PATH=securevault.db

# Storage & File Vault Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Security & Compliance Flags
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
