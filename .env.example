# SecureVault Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_key_for_flask_sessions
MASTER_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# Database Configuration (MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=securevault_db

# Fallback SQLite DB path
SQLITE_DB_PATH=securevault.db
